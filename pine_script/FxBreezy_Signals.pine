//@version=6
indicator("FxBreezy Signals", overlay=true, max_bars_back=500, max_lines_count=100, max_labels_count=50)

// ── INPUTS ──────────────────────────────────────────────────
ema_fast_len  = input.int(50,    "Fast EMA (Trend)",           group="Trend")
ema_slow_len  = input.int(200,   "Slow EMA (Trend)",           group="Trend")
vol_ma_len    = input.int(20,    "Volume MA Length",           group="Volume")
vol_mult      = input.float(2.0, "Volume Multiplier (x avg)", group="Volume", minval=1.0, step=0.1)
atr_len       = input.int(14,    "ATR Length",                group="Risk")
atr_mult      = input.float(1.5, "ATR Stop-Loss Multiplier",  group="Risk")
rr_ratio      = input.float(2.0, "Risk : Reward Ratio",       group="Risk")
cooldown_bars = input.int(10,    "Min Bars Between Signals",  group="Filter", minval=1)
show_emas     = input.bool(true,  "Show EMAs",                group="Display")
show_sessions = input.bool(true,  "Highlight Sessions",       group="Display")

// ── SESSIONS (GMT) ──────────────────────────────────────────
london_t    = time(timeframe.period, "0800-1700:1234567", "GMT+0")
ny_t        = time(timeframe.period, "1300-2200:1234567", "GMT+0")
in_london   = not na(london_t)
in_ny       = not na(ny_t)
in_session  = in_london or in_ny
session_tag = in_london ? "London" : "New York"

// ── TREND  EMA 50 / 200 ─────────────────────────────────────
ema_fast   = ta.ema(close, ema_fast_len)
ema_slow   = ta.ema(close, ema_slow_len)
bull_trend = ema_fast > ema_slow
bear_trend = ema_fast < ema_slow

// ── EMA SLOPE  (trend must be moving, not flat) ───────────────
bull_slope = ema_fast > ema_fast[3]
bear_slope = ema_fast < ema_fast[3]

// ── VOLUME ──────────────────────────────────────────────────
vol_avg  = ta.sma(volume, vol_ma_len)
high_vol = volume > vol_avg * vol_mult

// ── PRICE ACTION ────────────────────────────────────────────
body       = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low
total_rng  = high - low

// Strong engulfing: current body must be larger than previous candle's full range
bull_engulf = close > open and close[1] < open[1] and body > total_rng[1] * 0.8 and close > high[1]
bear_engulf = close < open and close[1] > open[1] and body > total_rng[1] * 0.8 and close < low[1]

// Quality pin bars: wick at least 2.5x body
bull_pin = body > 0 and lower_wick >= body * 2.5 and upper_wick <= body * 0.3
bear_pin = body > 0 and upper_wick >= body * 2.5 and lower_wick <= body * 0.3

bull_pa = bull_engulf or bull_pin
bear_pa = bear_engulf or bear_pin

// ── COOLDOWN  (no repeat signals within N bars) ────────────────
var int last_buy_bar  = -999
var int last_sell_bar = -999

buy_ready  = bar_index - last_buy_bar  >= cooldown_bars
sell_ready = bar_index - last_sell_bar >= cooldown_bars

// ── SIGNALS ─────────────────────────────────────────────────
buy_signal  = bull_trend and bull_slope and in_session and high_vol and bull_pa and buy_ready
sell_signal = bear_trend and bear_slope and in_session and high_vol and bear_pa and sell_ready

// ── R:R LEVELS ──────────────────────────────────────────────
atr = ta.atr(atr_len)

if buy_signal
    last_buy_bar := bar_index
    float entry      = close
    float sl         = entry - atr * atr_mult
    float tp         = entry + atr * atr_mult * rr_ratio
    string lbl_text  = "🟢 BUY | RR 1:" + str.tostring(rr_ratio, "#.#") + "  Entry: " + str.tostring(entry, "#.#####") + "  SL: " + str.tostring(sl, "#.#####") + "  TP: " + str.tostring(tp, "#.#####")
    string alert_msg = "BUY|" + syminfo.ticker + "|" + str.tostring(entry, "#.#####") + "|" + str.tostring(sl, "#.#####") + "|" + str.tostring(tp, "#.#####") + "|" + session_tag + "|" + str.tostring(rr_ratio, "#.#")
    l_tp    = line.new(bar_index, tp,    bar_index + 1, tp,    extend=extend.right, color=color.green, style=line.style_solid,  width=2)
    l_entry = line.new(bar_index, entry, bar_index + 1, entry, extend=extend.right, color=color.white, style=line.style_dashed, width=1)
    l_sl    = line.new(bar_index, sl,    bar_index + 1, sl,    extend=extend.right, color=color.red,   style=line.style_solid,  width=2)
    linefill.new(l_entry, l_tp, color=color.new(color.green, 88))
    linefill.new(l_sl,    l_entry, color=color.new(color.red, 88))
    label.new(bar_index, tp, lbl_text, style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
    alert(alert_msg, alert.freq_once_per_bar)

if sell_signal
    last_sell_bar := bar_index
    float entry      = close
    float sl         = entry + atr * atr_mult
    float tp         = entry - atr * atr_mult * rr_ratio
    string lbl_text  = "🔴 SELL | RR 1:" + str.tostring(rr_ratio, "#.#") + "  Entry: " + str.tostring(entry, "#.#####") + "  SL: " + str.tostring(sl, "#.#####") + "  TP: " + str.tostring(tp, "#.#####")
    string alert_msg = "SELL|" + syminfo.ticker + "|" + str.tostring(entry, "#.#####") + "|" + str.tostring(sl, "#.#####") + "|" + str.tostring(tp, "#.#####") + "|" + session_tag + "|" + str.tostring(rr_ratio, "#.#")
    l_sl    = line.new(bar_index, sl,    bar_index + 1, sl,    extend=extend.right, color=color.red,   style=line.style_solid,  width=2)
    l_entry = line.new(bar_index, entry, bar_index + 1, entry, extend=extend.right, color=color.white, style=line.style_dashed, width=1)
    l_tp    = line.new(bar_index, tp,    bar_index + 1, tp,    extend=extend.right, color=color.green, style=line.style_solid,  width=2)
    linefill.new(l_entry, l_sl,  color=color.new(color.red,   88))
    linefill.new(l_tp,    l_entry, color=color.new(color.green, 88))
    label.new(bar_index, sl, lbl_text, style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    alert(alert_msg, alert.freq_once_per_bar)

// ── PLOTS ───────────────────────────────────────────────────
plot(show_emas ? ema_fast : na, "EMA 50",  color=color.new(color.blue,   0), linewidth=1)
plot(show_emas ? ema_slow : na, "EMA 200", color=color.new(color.orange, 0), linewidth=2)
bgcolor(show_sessions and in_london and not in_ny ? color.new(color.blue,   93) : na, title="London Session")
bgcolor(show_sessions and in_ny                   ? color.new(color.orange, 93) : na, title="New York Session")
plotshape(buy_signal,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal, title="Buy Signal")
plotshape(sell_signal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.normal, title="Sell Signal")
