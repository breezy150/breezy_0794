//@version=6
indicator("FxBreezy Signals", overlay=true, max_bars_back=500)

// ── INPUTS ────────────────────────────────────────────────
ema_fast_len  = input.int(50,    "Fast EMA (Trend)",           group="Trend")
ema_slow_len  = input.int(200,   "Slow EMA (Trend)",           group="Trend")
vol_ma_len    = input.int(20,    "Volume MA Length",           group="Volume")
vol_mult      = input.float(2.0, "Volume Multiplier (x avg)", group="Volume", minval=1.0, step=0.1)
atr_len       = input.int(14,    "ATR Length",                group="Risk")
atr_mult      = input.float(1.5, "ATR Stop-Loss Multiplier",  group="Risk")
rr_ratio      = input.float(2.0, "Risk : Reward Ratio",       group="Risk")
cooldown_bars = input.int(10,    "Min Bars Between Signals",  group="Filter", minval=1)
show_emas     = input.bool(true,  "Show EMAs",                group="Display")
show_sessions = input.bool(true,  "Highlight Sessions",       group="Display")

// ── SESSIONS (GMT) ──────────────────────────────────────────
london_t    = time(timeframe.period, "0800-1700:1234567", "GMT+0")
ny_t        = time(timeframe.period, "1300-2200:1234567", "GMT+0")
in_london   = not na(london_t)
in_ny       = not na(ny_t)
in_session  = in_london or in_ny
session_tag = in_london ? "London" : "New York"

// ── TREND ───────────────────────────────────────────────────
ema_fast   = ta.ema(close, ema_fast_len)
ema_slow   = ta.ema(close, ema_slow_len)
bull_trend = ema_fast > ema_slow
bear_trend = ema_fast < ema_slow
bull_slope = ema_fast > ema_fast[3]
bear_slope = ema_fast < ema_fast[3]

// ── VOLUME ──────────────────────────────────────────────────
vol_avg  = ta.sma(volume, vol_ma_len)
high_vol = volume > vol_avg * vol_mult

// ── PRICE ACTION ────────────────────────────────────────────
body       = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low
total_rng  = high - low

bull_engulf = close > open and close[1] < open[1] and body > total_rng[1] * 0.8 and close > high[1]
bear_engulf = close < open and close[1] > open[1] and body > total_rng[1] * 0.8 and close < low[1]
bull_pin    = body > 0 and lower_wick >= body * 2.5 and upper_wick <= body * 0.3
bear_pin    = body > 0 and upper_wick >= body * 2.5 and lower_wick <= body * 0.3
bull_pa     = bull_engulf or bull_pin
bear_pa     = bear_engulf or bear_pin

// ── COOLDOWN ────────────────────────────────────────────────
var int last_buy_bar  = -999
var int last_sell_bar = -999
buy_ready  = bar_index - last_buy_bar  >= cooldown_bars
sell_ready = bar_index - last_sell_bar >= cooldown_bars

// ── CONDITIONS ───────────────────────────────────────────────
raw_buy  = bull_trend and bull_slope and in_session and high_vol and bull_pa and buy_ready
raw_sell = bear_trend and bear_slope and in_session and high_vol and bear_pa and sell_ready

buy_signal  = raw_buy  and barstate.islast
sell_signal = raw_sell and barstate.islast

// ── DRAWING OBJECTS ───────────────────────────────────────────
var line     l_tp      = na
var line     l_entry   = na
var line     l_sl      = na
var linefill lf_profit = na
var linefill lf_loss   = na
var label    lbl_tp    = na
var label    lbl_sl    = na
var label    lbl_entry = na

atr = ta.atr(atr_len)

if buy_signal
    line.delete(l_tp)
    line.delete(l_entry)
    line.delete(l_sl)
    linefill.delete(lf_profit)
    linefill.delete(lf_loss)
    label.delete(lbl_tp)
    label.delete(lbl_sl)
    label.delete(lbl_entry)

    float entry   = close
    float sl      = entry - atr * atr_mult
    float tp      = entry + atr * atr_mult * rr_ratio
    float pip_val = syminfo.mintick * 10
    float sl_pips = math.abs(entry - sl) / pip_val
    float tp_pips = math.abs(tp - entry) / pip_val
    float sl_pct  = math.abs(entry - sl) / entry * 100
    float tp_pct  = math.abs(tp - entry) / entry * 100

    // extend.both — lines span full chart left+right, always in sync with candles
    l_tp    := line.new(bar_index, tp,    bar_index + 1, tp,    extend=extend.both, color=color.new(color.green, 0), style=line.style_solid,  width=2)
    l_entry := line.new(bar_index, entry, bar_index + 1, entry, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed, width=1)
    l_sl    := line.new(bar_index, sl,    bar_index + 1, sl,    extend=extend.both, color=color.new(color.red,   0), style=line.style_solid,  width=2)
    lf_profit := linefill.new(l_entry, l_tp, color=color.new(color.green, 50))
    lf_loss   := linefill.new(l_sl,    l_entry, color=color.new(color.red,   50))

    lbl_tp    := label.new(bar_index, tp,    "▲ TAKE PROFIT   +" + str.tostring(tp_pips, "#.0") + " pips  (+" + str.tostring(tp_pct, "#.##") + "%)\n" + str.tostring(tp, "#.#####"), style=label.style_label_left, color=color.new(color.green, 10), textcolor=color.white, size=size.small)
    lbl_entry := label.new(bar_index, entry, "● BUY   Entry: "  + str.tostring(entry, "#.#####") + "   RR 1:" + str.tostring(rr_ratio, "#.#") + "   " + session_tag,              style=label.style_label_left, color=color.new(color.gray,  20), textcolor=color.white, size=size.small)
    lbl_sl    := label.new(bar_index, sl,    "▼ STOP LOSS     -" + str.tostring(sl_pips, "#.0") + " pips  (-" + str.tostring(sl_pct,  "#.##") + "%)\n" + str.tostring(sl, "#.#####"), style=label.style_label_left, color=color.new(color.red,   10), textcolor=color.white, size=size.small)

if sell_signal
    line.delete(l_tp)
    line.delete(l_entry)
    line.delete(l_sl)
    linefill.delete(lf_profit)
    linefill.delete(lf_loss)
    label.delete(lbl_tp)
    label.delete(lbl_sl)
    label.delete(lbl_entry)

    float entry   = close
    float sl      = entry + atr * atr_mult
    float tp      = entry - atr * atr_mult * rr_ratio
    float pip_val = syminfo.mintick * 10
    float sl_pips = math.abs(entry - sl) / pip_val
    float tp_pips = math.abs(tp - entry) / pip_val
    float sl_pct  = math.abs(entry - sl) / entry * 100
    float tp_pct  = math.abs(tp - entry) / entry * 100

    l_sl    := line.new(bar_index, sl,    bar_index + 1, sl,    extend=extend.both, color=color.new(color.red,   0), style=line.style_solid,  width=2)
    l_entry := line.new(bar_index, entry, bar_index + 1, entry, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed, width=1)
    l_tp    := line.new(bar_index, tp,    bar_index + 1, tp,    extend=extend.both, color=color.new(color.green, 0), style=line.style_solid,  width=2)
    lf_loss   := linefill.new(l_entry, l_sl,  color=color.new(color.red,   50))
    lf_profit := linefill.new(l_tp,    l_entry, color=color.new(color.green, 50))

    lbl_sl    := label.new(bar_index, sl,    "▲ STOP LOSS     -" + str.tostring(sl_pips, "#.0") + " pips  (-" + str.tostring(sl_pct,  "#.##") + "%)\n" + str.tostring(sl, "#.#####"), style=label.style_label_left, color=color.new(color.red,   10), textcolor=color.white, size=size.small)
    lbl_entry := label.new(bar_index, entry, "● SELL   Entry: " + str.tostring(entry, "#.#####") + "   RR 1:" + str.tostring(rr_ratio, "#.#") + "   " + session_tag,               style=label.style_label_left, color=color.new(color.gray,  20), textcolor=color.white, size=size.small)
    lbl_tp    := label.new(bar_index, tp,    "▼ TAKE PROFIT   +" + str.tostring(tp_pips, "#.0") + " pips  (+" + str.tostring(tp_pct, "#.##") + "%)\n" + str.tostring(tp, "#.#####"), style=label.style_label_left, color=color.new(color.green, 10), textcolor=color.white, size=size.small)

// ── ALERT on bar close ──────────────────────────────────────────
if raw_buy and barstate.isconfirmed and buy_ready
    last_buy_bar := bar_index
    float e = close
    float s = e - ta.atr(atr_len) * atr_mult
    float t = e + ta.atr(atr_len) * atr_mult * rr_ratio
    alert("BUY|"  + syminfo.ticker + "|" + str.tostring(e, "#.#####") + "|" + str.tostring(s, "#.#####") + "|" + str.tostring(t, "#.#####") + "|" + session_tag + "|" + str.tostring(rr_ratio, "#.#"), alert.freq_once_per_bar)

if raw_sell and barstate.isconfirmed and sell_ready
    last_sell_bar := bar_index
    float e = close
    float s = e + ta.atr(atr_len) * atr_mult
    float t = e - ta.atr(atr_len) * atr_mult * rr_ratio
    alert("SELL|" + syminfo.ticker + "|" + str.tostring(e, "#.#####") + "|" + str.tostring(s, "#.#####") + "|" + str.tostring(t, "#.#####") + "|" + session_tag + "|" + str.tostring(rr_ratio, "#.#"), alert.freq_once_per_bar)

// ── PLOTS ───────────────────────────────────────────────────
plot(show_emas ? ema_fast : na, "EMA 50",  color=color.new(color.blue,   0), linewidth=1)
plot(show_emas ? ema_slow : na, "EMA 200", color=color.new(color.orange, 0), linewidth=2)
bgcolor(show_sessions and in_london and not in_ny ? color.new(color.blue,   93) : na, title="London Session")
bgcolor(show_sessions and in_ny                   ? color.new(color.orange, 93) : na, title="New York Session")
